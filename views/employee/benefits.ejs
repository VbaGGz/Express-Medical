<!DOCTYPE html>
<html>
<head>
    <%- include('../partials/head') %>
    <title>My Benefits</title>
    <link rel="stylesheet" type="text/css" href="/css/homepage.css">
</head>
<body>
    <div class="container-fluid full-page">
        <%- include('../partials/nav') %>
        <%- include('../partials/header') %>
        <div class="row">
            <div class="tabcontent">
                <h3>My Benefits:</h3>
                <% if (healthcare) { %>
                <p>
                    Marital Status: <%= healthcare.Marital_Status %> &nbsp; Children: <%= healthcare.Children %><br>
                    Healthcare Plan: <%= healthcare.Healthcare_Plan %> &nbsp; Dental Plan: <%= healthcare.Dental %><br>
                    Optical Plan: <%= healthcare.Optical %> &nbsp; Life Insurance: <%= healthcare.Life_Insurance_Plan %><br>
                    401k: <%= healthcare['401k'] %><br>
                </p>
                <% } else { %>
                <p>No healthcare information on file.</p>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
