<!DOCTYPE html>
<html>
<head>
    <%- include('../partials/head') %>
    <title>Contact</title>
    <link rel="stylesheet" type="text/css" href="/css/homepage.css">
    <link rel="stylesheet" type="text/css" href="/css/contact.css">
</head>
<body>
    <div class="container-fluid full-page">
        <%- include('../partials/nav') %>
        <%- include('../partials/header') %>
        <div class="row">
            <div class="tabcontent">
                <h2>Contact</h2>
                <input type="text" id="myInput" onkeyup="filterTable()" placeholder="Search for names..">
                <table id="myTable">
                    <tr class="header">
                        <th style="width:25%;">Name</th>
                        <th style="width:25%;">Position</th>
                        <th style="width:25%;">Email</th>
                        <th style="width:25%;">Phone #</th>
                        <th style="width:25%;">ID #</th>
                    </tr>
                    <% employees.forEach(emp => { %>
                    <tr class="clickable-row" onclick="location.href='/<%= role %>/profile?ID=<%= emp.ID %>'">
                        <td><%= emp.First_Name %> <%= emp.Last_Name %></td>
                        <td><%= emp.Position %></td>
                        <td><%= emp.Email %></td>
                        <td><%= emp.Phone_Number %></td>
                        <td><%= emp.ID %></td>
                    </tr>
                    <% }) %>
                </table>
            </div>
        </div>
    </div>
    <script>
    function filterTable() {
        var filter = document.getElementById("myInput").value.toUpperCase();
        var tr = document.getElementById("myTable").getElementsByTagName("tr");
        for (var i = 0; i < tr.length; i++) {
            var tds = tr[i].getElementsByTagName("td");
            if (tds.length === 0) continue;
            var match = Array.from(tds).some(td => td.textContent.toUpperCase().includes(filter));
            tr[i].style.display = match ? "" : "none";
        }
    }
    </script>
</body>
</html>
