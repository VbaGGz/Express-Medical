<!DOCTYPE html>
<html>
<head>
    <%- include('../partials/head') %>
    <title>Edit Employee Benefits</title>
    <link rel="stylesheet" type="text/css" href="/css/homepage.css">
</head>
<body>
    <div class="container-fluid full-page">
        <%- include('../partials/nav') %>
        <%- include('../partials/header') %>
        <div class="row">
            <div class="tabcontent">
                <h2>Edit Employee Benefits:</h2>
                <% if (healthcare) { %>
                <p>ID: <%= healthcare.ID %></p>
                <form action="/<%= role %>/benefits/update?ID=<%= healthcare.ID %>" method="post">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Marital Status</label>
                            <input type="text" class="form-control" name="Marital_Status" value="<%= healthcare.Marital_Status %>">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Children</label>
                            <input type="text" class="form-control" name="Children" maxlength="2" value="<%= healthcare.Children %>">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>401k</label>
                            <input type="text" class="form-control" name="k401" value="<%= healthcare['401k'] %>">
                        </div>
                        <div class="form-group col-md-8">
                            <label>Healthcare Plan</label>
                            <input type="text" class="form-control" name="Healthcare_Plan" value="<%= healthcare.Healthcare_Plan %>">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Dental</label>
                        <input type="text" class="form-control" name="Dental" value="<%= healthcare.Dental %>">
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Optical</label>
                            <input type="text" class="form-control" name="Optical" value="<%= healthcare.Optical %>">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Life Insurance Plan</label>
                            <input type="text" class="form-control" name="Life_Insurance_Plan" value="<%= healthcare.Life_Insurance_Plan %>">
                        </div>
                    </div>
                    <input type="submit" value="Submit" class="btn btn-primary">
                </form>
                <% } %>
            </div>
        </div>
        <div>
            <form action="/<%= role %>/benefits/search" method="post">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Please Enter The ID of The User You Would Like To Edit</label>
                        <input type="text" class="form-control" name="ID" maxlength="6">
                    </div>
                    <input type="submit" value="Search" class="btn btn-primary">
                </div>
            </form>
        </div>
        <% if (error) { %>
        <div style="font-size:18px; color:#cc0000; margin-top:10px"><%= error %></div>
        <% } %>
    </div>
</body>
</html>
