<!DOCTYPE html>
<html>
<head>
    <%- include('../partials/head') %>
    <title>Add Employee</title>
    <link rel="stylesheet" type="text/css" href="/css/homepage.css">
</head>
<body>
    <div class="container-fluid full-page">
        <%- include('../partials/nav') %>
        <%- include('../partials/header') %>
        <div class="row">
            <div class="tabcontent">
                <h2>Add Employee:</h2>
                <form action="/<%= role %>/add-employee" method="post">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>First Name</label>
                            <input type="text" class="form-control" name="First_Name" maxlength="25" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Last Name</label>
                            <input type="text" class="form-control" name="Last_Name" maxlength="25" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Date of Birth</label>
                            <input type="date" class="form-control" name="DOB" required>
                        </div>
                        <div class="form-group col-md-8">
                            <label>Email</label>
                            <input type="email" class="form-control" name="Email" maxlength="50" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <input type="text" class="form-control" name="Address" placeholder="1234 Main St" maxlength="50" required>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>City</label>
                            <input type="text" class="form-control" name="City" maxlength="20" required>
                        </div>
                        <div class="form-group col-md-4">
                            <label>State</label>
                            <select class="form-control" name="State" required>
                                <%- include('../partials/states', { selected: null }) %>
                            </select>
                        </div>
                        <div class="form-group col-md-2">
                            <label>Zip</label>
                            <input type="text" class="form-control" name="Zip_Code" pattern="[0-9]{5}" title="Please enter a valid Zip" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Password</label>
                            <input type="password" class="form-control" id="Password" name="Password" pattern=".{8,50}" title="8 to 50 characters" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Confirm Password</label>
                            <input type="password" class="form-control" id="ConfPassword" pattern=".{8,50}" title="8 to 50 characters" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-3">
                            <label>Social Security Number</label>
                            <input type="password" class="form-control" id="SSN" name="SSN" pattern="[0-9]{9}" title="Please enter a valid SSN" required>
                        </div>
                        <div class="form-group col-md-3">
                            <label>Confirm SSN</label>
                            <input type="password" class="form-control" id="ConfSSN" pattern="[0-9]{9}" title="Please enter a valid SSN" required>
                        </div>
                        <div class="form-group col-md-3">
                            <label>Position</label>
                            <input type="text" class="form-control" name="Position" maxlength="25" required>
                        </div>
                        <div class="form-group col-md-3">
                            <label>Phone Number</label>
                            <input type="tel" class="form-control" name="Phone_Number" pattern="[0-9]{11}" title="Please enter a valid phone number" required>
                        </div>
                    </div>
                    <input type="submit" value="Submit" class="btn btn-primary">
                </form>
                <% if (error) { %>
                <div style="font-size:18px; color:#cc0000; margin-top:10px"><%= error %></div>
                <% } %>
            </div>
        </div>
    </div>
    <script>
    var pw = document.getElementById("Password"), cpw = document.getElementById("ConfPassword");
    function valPw() { cpw.setCustomValidity(pw.value !== cpw.value ? "Passwords Don't Match" : ''); }
    pw.onchange = valPw; cpw.onkeyup = valPw;
    var ssn = document.getElementById("SSN"), cssn = document.getElementById("ConfSSN");
    function valSSN() { cssn.setCustomValidity(ssn.value !== cssn.value ? "SSNs Don't Match" : ''); }
    ssn.onchange = valSSN; cssn.onkeyup = valSSN;
    </script>
</body>
</html>
